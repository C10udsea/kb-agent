# 复制本文件为 .env，然后填入你实际拥有的 Key：
#   Windows PowerShell: Copy-Item .env.example .env
#
# ============================================================
# 国内推荐组合：LLM = DeepSeek，Embedding = 智谱 GLM
# ============================================================

# 可选：auto（自动探测）/ deepseek / glm / anthropic / openai
LLM_PROVIDER=deepseek

# DeepSeek：https://platform.deepseek.com/
DEEPSEEK_API_KEY=在这里填入你的DeepSeekKey
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 智谱 GLM（同时用于 Embedding）：https://open.bigmodel.cn/
GLM_API_KEY=在这里填入你的GLMKey
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 对话模型，可选 glm-4-flash（免费/便宜）、glm-4.5、glm-4-plus 等
GLM_MODEL=glm-4-flash

# Embedding 服务商：glm 是国内推荐；DeepSeek 不提供 Embedding API
EMBEDDING_PROVIDER=glm
# 智谱 Embedding 模型：embedding-3；如报模型不存在可改 embedding-2
GLM_EMBEDDING_MODEL=embedding-3
# 注意：更换 Embedding 服务商/模型后，需重新入库：
#   python scripts/ingest.py --clear

# ============================================================
# 可选：未来若能访问 Anthropic / Voyage，取消注释即可使用
# ============================================================
# ANTHROPIC_API_KEY=在这里填入你的Key
# ANTHROPIC_MODEL=claude-sonnet-4-5
# VOYAGE_API_KEY=在这里填入你的Key
# VOYAGE_MODEL=voyage-3-lite
